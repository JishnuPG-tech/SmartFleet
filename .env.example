# ==============================================================================
# TruckConnect Environment Configuration
# Copy this file to .env and supply the required values.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Supabase Credentials (Provided in Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Firebase Admin Credentials (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# In-App Update Configuration
APK_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/releases/
